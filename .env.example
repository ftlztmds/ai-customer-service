# Copy this file to `.env.local` and fill in your own keys.
# Chat model: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Embeddings（语义检索用）：https://cloud.siliconflow.cn/
# 注意 DeepSeek 没有 embedding 接口，向量化必须用另一家
EMBEDDING_API_KEY=your_siliconflow_api_key_here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
